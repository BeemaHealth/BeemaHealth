                "cue": "stomach"
              },
              {
                "t": "Stomach fluid",
                "cue": "fluid"
              },
              {
                "t": "A protein in it",
                "cue": "protein"
              },
              {
                "t": "A long chain of amino acids",
                "cue": "long"
              },
              {
                "t": "Based on one short piece",
                "cue": "based"
              },
              {
                "t": "That piece: 15 amino acids",
                "cue": "piece"
