            ]
          },
          "screen": null,
          "emph": [
            "stomach",
            "protein",
            "short piece"
          ]
        },
        {
          "text": "Here's the thing, most of what's been published comes from lab and animal studies.",
          "visual": {
            "type": "kinetic",
            "bg": "cream",
            "callouts": [
              {
                "t": "Lab studies",
                "at": "lab"
              },
              {
