    {
      "id": "TRZ-M1",
      "product": "tirzepatide",
      "title": "Two signals, one medicine",
      "style": "explainer",
      "beats": [
        {
          "text": "After you eat, your gut sends hormone signals to your brain that say, you're getting full.",
          "visual": {
            "type": "diagram",
            "preset": "gut_brain",
            "stage": "signal",
            "bg": "ink"
          },
          "screen": "Gut to brain",
          "emph": [
            "hormone"
          ]
        },
        {
          "text": "Tirzepatide mimics two of those signals, called GIP and GLP-1.",
          "visual": {
            "type": "diagram",
            "preset": "gut_brain",
            "stage": "dual",
            "bg": "ink"
          },
          "screen": "GIP and GLP-1",
          "emph": [
            "GIP",
            "GLP-1"
          ]
        },
        {
          "text": "Those signals act on appetite centers in the brain, and slow how fast the stomach empties.",
          "visual": {
            "type": "diagram",
            "preset": "gut_brain",
            "stage": "stomach",
            "bg": "ink"
          },
          "screen": "Appetite and stomach",
          "emph": [
            "appetite"
          ]
        },
        {
          "text": "It's a medicine, not a shortcut, and a provider decides if it's appropriate.",
          "visual": {
            "type": "kinetic",
            "bg": "honey"
          },
          "screen": null,
