    {
      "id": "SIL-M1",
      "product": "sildenafil",
      "title": "How sildenafil works, simply",
      "style": "explainer",
      "beats": [
        {
          "text": "Sildenafil is a PDE5 inhibitor. That's the medical name for what it does.",
          "visual": {
            "type": "product",
            "bg": "cream",
            "tags": [
              "Sildenafil",
              "PDE5 inhibitor"
            ]
          },
          "screen": "PDE5 inhibitor",
          "emph": [
            "PDE5"
          ]
        },
        {
          "text": "Normally, a signal called cyclic G M P tells blood vessels to relax. An enzyme, PDE5, clears that signal away.",
          "visual": {
            "type": "diagram",
            "preset": "pde5_flow",
            "stage": "enzyme",
            "bg": "ink"
          },
          "screen": "Signal and enzyme",
          "emph": [
            "PDE5"
          ]
        },
        {
          "text": "Sildenafil blocks the enzyme. The signal sticks around, and vessels can widen when there's stimulation.",
          "visual": {
            "type": "diagram",
            "preset": "pde5_flow",
            "stage": "blocked",
            "bg": "ink"
          },
          "screen": "Enzyme blocked",
          "emph": [
            "blocks"
          ]
        },
        {
          "text": "Stimulation is still required. The medicine only supports what the body already does.",
          "visual": {
            "type": "kinetic",
            "bg": "honey"
          },
          "screen": null,
          "emph": [
            "still required"
          ]
        }
      ],
      "words": 61,
