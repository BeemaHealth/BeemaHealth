    {
      "id": "TAD-M1",
      "product": "tadalafil",
      "title": "How tadalafil works, simply",
      "style": "explainer",
      "beats": [
        {
          "text": "Tadalafil belongs to a group of medicines called PDE5 inhibitors.",
          "visual": {
            "type": "product",
            "bg": "cream",
            "tags": [
              "Tadalafil",
              "PDE5 inhibitor"
            ]
          },
          "screen": "PDE5 inhibitor",
          "emph": [
            "PDE5"
          ]
        },
        {
          "text": "PDE5 is an enzyme. It breaks down a signal that tells blood vessels to relax.",
          "visual": {
            "type": "diagram",
            "preset": "pde5_flow",
            "stage": "enzyme",
            "bg": "ink"
          },
          "screen": "The enzyme",
          "emph": [
            "enzyme"
          ]
        },
        {
          "text": "Tadalafil blocks that enzyme, so the signal lasts longer and vessels can widen when there's stimulation.",
          "visual": {
            "type": "diagram",
            "preset": "pde5_flow",
            "stage": "blocked",
            "bg": "ink"
          },
          "screen": "Blocked",
          "emph": [
            "blocks",
            "stimulation"
          ]
        },
        {
          "text": "It doesn't create arousal on its own. That part still has to happen.",
          "visual": {
            "type": "kinetic",
            "bg": "honey"
          },
          "screen": null,
          "emph": [
            "arousal"
          ]
        }
      ],
      "words": 54,
      "est_seconds": 22.2,
      "caption_bodies": [
        "PDE5 inhibitors block the enzyme that breaks down a relaxation signal, so blood vessels can widen with stimulation. It doesn't cause arousal on its own."
      ],
      "claims": [
        "pde5_mechanism",
        "needs_stimulation"
      ],
